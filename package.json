{
  "name": "serverest-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "ServeRest frontend and API tests using Cypress and JavaScript",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "cy:open": "cypress open --e2e",
    "cy:verify": "cypress verify",
    "test": "cypress run --e2e --browser electron",
    "test:frontend": "cypress run --e2e --browser electron --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:api": "cypress run --e2e --browser electron --config-file cypress.api.config.js"
  },
  "devDependencies": {
    "cypress": "16.1.0"
  }
}
